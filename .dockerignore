# Konteyner ichiga TUSHMASLIGI kerak bo'lganlar.
# Bu fayl qurilish tezligiga ham, xavfsizlikka ham ta'sir qiladi.

# ⚠️ Sirlar
.env
.env.*
!.env.example
*.pem
*.key

# Lokal virtual muhit — konteynerda o'ziniki bor.
# Bu ayniqsa muhim: Windows'da qurilgan .venv Linux'da ISHLAMAYDI.
.venv/
venv/
env/

__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

.git/
.gitignore
.gitattributes

node_modules/
frontend/node_modules/

# Qurilish natijalari — konteynerda qaytadan yaratiladi
staticfiles/
media/
# ⚠️⚠️ MAXFIY HUJJATLAR obrazga TUSHMASLIGI SHART.
#    Bu katalog `.gitignore` da bor, lekin bu yerda YO'Q edi va
#    `COPY . .` uni obraz ichiga ko'chirardi — 1105 ta fayl. Ular
#    sinov to'ldirmasi edi (hammasi 21 bayt, "soxta diplom"), lekin
#    lokalda haqiqiy hujjat turgan kunda u GHCR'ga ketadigan obrazga
#    tushardi. Prod'da bu katalog volume'dan keladi.
maxfiy/

# Hujjatlar va maket skrinshotlari
*.md
!README.md
frontend/design-system/screenshots/

.vscode/
.idea/
.playwright-mcp/
