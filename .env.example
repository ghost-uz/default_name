# =========================================================================
#  Dard.uz — muhit o'zgaruvchilari namunasi
# =========================================================================
#
#   cp .env.example .env
#
# ⚠️ .env HECH QACHON git'ga tushmaydi (.gitignore da). Sir tasodifan
#    commit qilinsa — uni almashtirish kerak, tarixdan o'chirish yetarli emas.
#
# USTUVORLIK: haqiqiy muhit o'zgaruvchisi bu fayldan USTUN turadi.
#   Docker'da qiymatlarni compose beradi -> .env e'tiborga olinmaydi.
#   Bu ataylab: obrazga xato bilan tushgan eski .env prod bazasini
#   almashtirib yuborishi mumkin edi.
#
# BELGILAR:  [DEV]  dev'da shart emas, standart qiymat bor
#            [PROD] prod'da MAJBURIY — bo'lmasa server ko'tarilmaydi
#            [—]    ixtiyoriy, bo'sh bo'lsa integratsiya o'chiq
#
# Boshqa joydagi faylni ko'rsatish:  DJANGO_ENV_FILE=/path/to/.env


# ------------------------------------------------------------- Django ----

# [PROD] Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ⚠️ Kamida 50 belgi va yetarlicha xilma-xil bo'lsin — aks holda
#    `check --deploy` W009 ogohlantirishini beradi.
DJANGO_SECRET_KEY=

# [PROD] Vergul bilan ajratilgan. Bo'sh bo'lsa prod ishga TUSHMAYDI.
DJANGO_ALLOWED_HOSTS=dard.uz,www.dard.uz

# [—] Standart: https:// + har bir ALLOWED_HOSTS
DJANGO_CSRF_TRUSTED_ORIGINS=

# [DEV] Standart /admin/ — botlar eng ko'p urinadigan yo'l.
# Prod'da taxmin qilib bo'lmaydigan qiymat qo'ying.
DJANGO_ADMIN_URL=admin

# [DEV] DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO


# --------------------------------------------------------- PostgreSQL ----
#
# IKKI usuldan BIRINI tanlang.
#
# 1-usul — DATABASE_URL (boshqariladigan bazalar: DigitalOcean, Neon,
#          Supabase shu formatda bitta qator beradi). Berilsa — USTUN.
#          ⚠️ Paroldagi @ : / belgilari %40 %3A %2F ko'rinishida yozilsin.
# DATABASE_URL=postgres://dard:parol@db.example.com:5432/dard

# 2-usul — alohida o'zgaruvchilar (Docker Compose uchun qulay, chunki
#          postgres konteyneri baribir shularni talab qiladi).
POSTGRES_DB=dard
POSTGRES_USER=dard
POSTGRES_PASSWORD=dard
POSTGRES_HOST=127.0.0.1
# ⚠️ 5434, 5432 EMAS — bu mashinada boshqa stek'lar 5432 ni band qilishi
#    mumkin. Konteyner ICHIDA baribir 5432 ishlatiladi (compose beradi).
POSTGRES_PORT=5434

# [—] Ulanishni qayta ishlatish (soniya). 0 = har so'rovda yangi ulanish.
DB_CONN_MAX_AGE=60


# --------------------------------------------------------------- Redis ---
REDIS_URL=redis://127.0.0.1:6381/0

# [DEV] 0 bo'lsa kesh xotirada (locmem) — Redis'siz ham ishlaydi
USE_REDIS_IN_DEV=0


# -------------------------------------------------------------- Celery ---
# Kesh (/0) dan ALOHIDA bazalar.
# ⚠️ Bitta bazani baham ko'rish xavfli: cache.clear() navbatdagi
#    vazifalarni ham o'chirib yuboradi.
CELERY_BROKER_URL=redis://127.0.0.1:6381/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6381/2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240


# ------------------------------------------------------------ Telegram ---
# D1-T1 (kirish) va D5-T2 (bildirishnomalar). @BotFather dan olinadi.
#
# ⚠️ Bu token FAQAT xabar yuborish kaliti emas — login imzosi (HMAC) ham
#    shundan hosil qilinadi. Ya'ni token sizib chiqsa, istalgan odam
#    istalgan foydalanuvchi nomidan tizimga kira oladi. Sir sifatida
#    saqlang: jurnalga, shablonga yoki front-end'ga TUSHMASIN.
TELEGRAM_BOT_TOKEN=

# Login Widget uchun bot nomi (@ belgisisiz)
TELEGRAM_BOT_USERNAME=

# [—] D5-T3 — qaynoq postlar avtomatik yuboriladigan kanal (masalan -1001234567890)
TELEGRAM_CHANNEL_ID=


# -------------------------------------------------------------- Sentry ---
# [—] D7-T1. Bo'sh bo'lsa Sentry o'chiq (dev uchun normal).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Tranzaksiyalarning necha ulushi yuboriladi (0.0 - 1.0).
# Prod'da 1.0 qo'ymang — kvota tez tugaydi.
SENTRY_TRACES_SAMPLE_RATE=0.1


# ------------------------------------------------- HTTPS / xavfsizlik ----
# [PROD] Birinchi deploy'da kichik qiymatdan boshlang. Sertifikat buzilsa,
# uzun HSTS saytni brauzerlarda uzoq muddat yopib qo'yadi.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=1
# ⚠️ preload ro'yxatiga qo'shilish amalda QAYTARIB BO'LMAYDI — domen
#    barqaror bo'lgach yoqing.
DJANGO_HSTS_PRELOAD=0
DJANGO_SECURE_SSL_REDIRECT=1


# --------------------------------------------------------------- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Dard.uz <yordam@dard.uz>
# Server xatolari yuboriladigan manzillar (vergul bilan)
DJANGO_ADMIN_EMAILS=


# ------------------------------------------------------------ To'lovlar ---
# [—] D6-T2 / D6-T3. Auditoriya shakllangandan keyin sozlanadi.
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=


# ------------------------------------------------------ Docker Compose ---
# ⚠️ Bu FAQAT host portlari. Konteynerlar o'zaro ichki portlar (5432/6379)
#    orqali gaplashadi — buni docker-compose.yml environment'da beradi.
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
WEB_HOST_PORT=8001
NGINX_HOST_PORT=80
