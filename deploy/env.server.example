# =========================================================================
#  Dard.uz — SERVER uchun .env namunasi
# =========================================================================
#
# Serverda:  /opt/dard/.env
# Ruxsatlar: chmod 600 .env   (ichida parollar bor)
#
# ⚠️ Bu fayl git'ga TUSHMAYDI va HECH QACHON chatga/xabarga yozilmaydi.
#
# Loyihaning `.env.example` faylidan farqi: bu yerda faqat serverga
# kerakli qiymatlar bor va hammasi TO'LDIRILISHI shart.


# ---------------------------------------------------------------- Obraz ---
# CI qurgan obraz. Deploy workflow uni har safar yangilaydi.
# Orqaga qaytarish: eski commit SHA'sini yozib, `up -d` qiling.
DARD_IMAGE=ghcr.io/EGASI/dard:latest


# --------------------------------------------------------------- Django ---
# MAJBURIY. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ⚠️ Bo'sh qoldirilsa server KO'TARILMAYDI (config/settings/env.py).
DJANGO_SECRET_KEY=

# MAJBURIY. Domen olinmaguncha — droplet IP'si.
# Domen olingach: dard.uz,www.dard.uz
DJANGO_ALLOWED_HOSTS=

# ⚠️⚠️ VAQTINCHALIK: domen va TLS yo'q bosqich uchun 0.
#
#   DJANGO_HTTPS=0 bo'lganda:
#     · SECURE_SSL_REDIRECT  -> False (aks holda cheksiz redirect)
#     · SESSION_COOKIE_SECURE -> False (aks holda admin'ga KIRIB BO'LMAYDI)
#     · CSRF_COOKIE_SECURE   -> False
#     · HSTS                 -> 0
#
#   Uchalasi BIR kalitdan boshqariladi, ya'ni yarim holat mumkin emas.
#
#   Sertifikat o'rnatilgach 1 ga o'zgartiring (DEPLOY.md -> "TLS qo'shish").
#   Shu holatda `check --deploy` ogohlantirish beradi — bu TO'G'RI:
#   HTTPS'siz ishlayotganingizni eslatib turishi kerak.
DJANGO_HTTPS=0

# Standart /admin/ botlar eng ko'p urinadigan yo'l — taxmin qilib
# bo'lmaydigan qiymat qo'ying.
DJANGO_ADMIN_URL=

LOG_LEVEL=INFO


# ----------------------------------------------------------- PostgreSQL ---
# ⚠️ Bu qiymatlarni `db` konteyneri HAM ishlatadi (env_file umumiy).
#    Parolni keyin o'zgartirmoqchi bo'lsangiz, baza ichidagi parolni ham
#    almashtirish kerak — oddiy .env tahriri yetarli EMAS.
POSTGRES_DB=dard
POSTGRES_USER=dard
POSTGRES_PASSWORD=

# ⚠️ POSTGRES_HOST va POSTGRES_PORT bu yerda YO'Q — ularni compose
#    fayli `db:5432` qilib beradi. Bu yerga yozilsa ular ustun chiqib,
#    konteyner o'zini o'ziga ulashga urinardi.


# ---------------------------------------------------------------- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Dard.uz <yordam@dard.uz>
DJANGO_ADMIN_EMAILS=


# ------------------------------------------------------------- Telegram ---
# D1-T1 (kirish) va D5-T2 (bildirishnomalar) da to'ldiriladi.
# ⚠️ Bu token login imzosini (HMAC) ham hosil qiladi — sizib chiqsa
#    istalgan odam istalgan foydalanuvchi nomidan kira oladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=


# --------------------------------------------------------------- Sentry ---
# D7-T1 da to'ldiriladi. Bo'sh bo'lsa o'chiq.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
